root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = block_scoped:silent
csharp_using_directive_placement = outside_namespace:silent
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:silent
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent

# The library also targets .NET Standard 2.0, which lacks the APIs these rules suggest.
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1511.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1513.severity = none
dotnet_diagnostic.CA1835.severity = none
dotnet_diagnostic.CA1845.severity = none
dotnet_diagnostic.CA1846.severity = none
dotnet_diagnostic.CA1847.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1867.severity = none
dotnet_diagnostic.CA2249.severity = none
# Interface-typed returns are part of the public contract.
dotnet_diagnostic.CA1859.severity = none
# Optional<T> is the name DESIGN.md section 5.1 gives the absent-or-set wrapper; Optional<T>.Unset is its absent value.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1000.severity = none
# The library never captures a synchronization context; ConfigureAwait(false) is used throughout.
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA2016.severity = none

[examples/**.cs]
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1812.severity = none
