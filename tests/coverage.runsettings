<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the hand-written core (DESIGN.md section 11). Generated code is excluded: it is covered by the generated tests. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Didit]*,[Didit.Extensions.DependencyInjection]*</Include>
          <Exclude>[Didit]Didit.Resources.*,[Didit]Didit.Internal.DiditJsonContext*</Exclude>
          <ExcludeByFile>**/Generated/**/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
