<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Didit</RootNamespace>
    <AssemblyName>Didit</AssemblyName>
    <PackageId>Didit</PackageId>
    <Title>Didit</Title>
    <Description>The official Didit .NET library: identity verification (KYC), business verification (KYB), AML screening, liveness and biometrics, transaction monitoring, Travel Rule and customer Authentication from your backend.</Description>
    <PackageTags>didit;identity verification;kyc;kyb;aml;liveness;transaction monitoring;travel rule;authentication</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- TEMP-INTEGRATION: modules built in parallel, folded in at integration. -->
  <ItemGroup>
    <Compile Remove="Authentication/**;Webhooks/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Didit.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>
